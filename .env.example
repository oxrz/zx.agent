# Copy this file to .env and fill in your own values: cp .env.example .env

# Remote ASR POC WebSocket service (Zipformer2 partial + OpenVINO Whisper final +
# CT2 CPU fallback, see audio/stt.py). Fill in your deployed service address
# and port -- a LAN IP or a domain name both work.
STT_SERVER_HOST=192.0.2.1
STT_SERVER_PORT=45678

# AI / LLM (shared by the ai: section in both the transcribe/assist config files).
# Not tied to any specific vendor -- any OpenAI-compatible /chat/completions endpoint works.
AI_PROVIDER=your-provider-name
AI_MODEL=your-model-name
AI_API_BASE=https://api.example.com
AI_API_KEY=your-api-key-here
